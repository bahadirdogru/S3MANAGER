{
	"name": "s3manager",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"tauri": "tauri",
		"test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
		"test:live": "cargo test --manifest-path src-tauri/Cargo.toml -- --ignored"
	},
	"devDependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.79.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@tauri-apps/cli": "^2.12.6",
		"@types/node": "^26.6.6",
		"bits-ui": "^2.22.0",
		"cn": "^0.5.2",
		"mode-watcher": "^1.1.0",
		"paneforge": "^1.0.2",
		"shadcn-svelte": "^1.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"svelte-sonner": "^1.2.3",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.8"
	},
	"dependencies": {
		"@tauri-apps/api": "^2.12.5",
		"@tauri-apps/plugin-clipboard-manager": "^2.5.0",
		"@tauri-apps/plugin-dialog": "^2.8.4",
		"@tauri-apps/plugin-opener": "^2.7.3"
	},
	"packageManager": "pnpm@12.23.0"
}
